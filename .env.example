# ============================================================================
#  Ai-dos — конфигурация ОРКЕСТРАТОРА (app/main.py). Читается app/config.py.
#  Тут только то, что использует оркестратор. Настройки самого RAG-сервиса
#  (эмбеддинги, индекс, top_k) живут ОТДЕЛЬНО в rag/.env.
# ============================================================================

# ===== LLM (qwen3-next-80b-instruct, OpenAI-совместимый, сервер АФМ) =====
# Нужен только для LLM-коррекции STT (по умолчанию — казахский).
LLM_BASE_URL=http://192.168.165.2:8901/v1
LLM_MODEL=qwen3-next-80b-instruct
LLM_API_KEY=EMPTY
LLM_TEMPERATURE=0.2
LLM_TOP_P=0.95
LLM_MAX_TOKENS=512

# ===== Speech-to-Text =====
STT_URL=http://192.168.165.2:8804/transcribe    # русский STT (сервер АФМ)
STT_DEFAULT_LANGUAGE=russian
# LLM-коррекция распознавания: мастер-выключатель + языки (пусто = выкл)
STT_CORRECTION=true
STT_CORRECTION_LANGS=kk
# Казахский STT — локальный Whisper-kk (офлайн, из кэша HF)
STT_KK_USE_WHISPER=true
WHISPER_KK_MODEL=shyngys879/kazakh-whisper-large-v3-turbo
WHISPER_DEVICE=auto                              # auto | cpu | mps | cuda

# ===== Text-to-Speech =====
# Русский: f5 (GPU-сервер АФМ или локальный) | say | openai.  Казахский: spark.
TTS_PROVIDER=f5
# Русский F5 на GPU-сервере АФМ (multipart — референс шлётся в каждый запрос):
F5_URL=http://192.168.165.2:8991/tts
F5_REF_AUDIO=refs/ref_ru_f5.wav
F5_REF_TEXT=@refs/ref_ru.txt
# Локальный русский F5 вместо GPU: F5_URL=http://localhost:8810/tts, убери F5_REF_*, старт c USE_LOCAL_F5=1
TTS_KK_PROVIDER=spark
SPARK_URL=http://localhost:8809/tts
TTS_FORMAT=wav

TTS_KK_PROVIDER=spark
SPARK_URL=http://localhost:8809/tts              # см. spark_server/
TTS_FORMAT=wav
# Нарезка длинного текста для TTS (обычно менять не нужно):
# TTS_MAX_CHARS=180       # макс. длина одного предложения для синтеза
# TTS_GROUP_CHARS=600     # группировка предложений в кусок (f5 делят сами)
# TTS_GAP_MS=80           # пауза на стыке склеиваемых кусков
# Внешний OpenAI-совместимый TTS (только если TTS_PROVIDER=openai):
# TTS_BASE_URL=
# TTS_MODEL=
# TTS_VOICE=
# TTS_API_KEY=dummy

# ===== RAG-сервис (основной источник ответа; свой venv, порт 8077) =====
RAG_URL=http://localhost:8077/ask
RAG_TIMEOUT=120
# LLM / эмбеддинги / индекс / top_k самого RAG — в rag/.env, НЕ здесь.

# ===== Загрузка аудио =====
MAX_UPLOAD_MB=25
