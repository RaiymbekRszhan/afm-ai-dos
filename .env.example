# ============================================================================
#  Ai-dos — конфигурация ОРКЕСТРАТОРА (app/main.py). Читается app/config.py.
#  Тут только то, что использует оркестратор. Настройки самого RAG-сервиса
#  (эмбеддинги, индекс, top_k) живут ОТДЕЛЬНО в rag/.env.
#  ⚠️ При запуске через run_api.sh провайдеры/адреса TTS, RAG_URL и
#     STT_KK_USE_WHISPER ЗАДАЁТ СКРИПТ (его export перебивает .env). Значения
#     ниже действуют при запуске без run_api.sh (systemd, голый uvicorn).
# ============================================================================

# ===== LLM (qwen3-next-80b-instruct, OpenAI-совместимый, сервер АФМ) =====
# Нужен для LLM-коррекции STT (казахский) и уточнения вопроса при промахе.
LLM_BASE_URL=http://192.168.165.2:8901/v1
LLM_MODEL=qwen3-next-80b-instruct
LLM_API_KEY=EMPTY
LLM_TEMPERATURE=0.2
LLM_TOP_P=0.95
LLM_MAX_TOKENS=512

# ===== Speech-to-Text =====
STT_URL=http://192.168.165.2:8804/transcribe    # STT сервер АФМ (ru И kk)
STT_DEFAULT_LANGUAGE=russian
# LLM-коррекция распознавания: мастер-выключатель + языки (пусто = выкл)
STT_CORRECTION=true
STT_CORRECTION_LANGS=kk
# Казахский STT по умолчанию — сервер АФМ :8804 (run_api.sh ставит
# STT_KK_USE_WHISPER=false). Две строки ниже нужны ТОЛЬКО если включишь
# локальный Whisper-kk: STT_KK_USE_WHISPER=true bash run_api.sh
WHISPER_KK_MODEL=shyngys879/kazakh-whisper-large-v3-turbo
WHISPER_DEVICE=auto                              # auto | cpu | mps | cuda

# ===== Text-to-Speech =====
# Русский — F5 (GPU-сервер АФМ, multipart: референс шлётся в каждый запрос).
TTS_PROVIDER=f5
F5_URL=http://192.168.165.2:8991/tts
F5_REF_AUDIO=refs/ref_ru_f5_padded.wav           # с тишиной по краям — мягкий старт
F5_REF_TEXT=@refs/ref_ru.txt
# Локальный русский F5 вместо GPU: старт с USE_LOCAL_F5=1 (адрес/референс переключит run_api.sh).

# Казахский — ElevenLabs (eleven_v3, облако; ⚠️ НУЖЕН ИНТЕРНЕТ к api.elevenlabs.io).
TTS_KK_PROVIDER=eleven
# Фолбэк без интернета — Spark на GPU АФМ: TTS_KK_PROVIDER=spark bash run_api.sh
SPARK_URL=http://192.168.165.2:8992/tts
TTS_FORMAT=wav
# Нарезка/паузы TTS — дефолты в app/config.py (240/280/300), обычно менять не нужно.

# Внешний OpenAI-совместимый TTS (только если TTS_PROVIDER=openai):
# TTS_BASE_URL=
# TTS_MODEL=
# TTS_VOICE=
# TTS_API_KEY=dummy

# ===== ElevenLabs (казахский TTS) =====
# Голос — казахский офицер.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=CwhRBWXzGAHq8TQ4Fs17
# ELEVENLABS_MODEL=eleven_v3   # дефолт, можно не указывать

# ===== RAG-сервис (основной источник ответа; свой venv, порт 8077) =====
RAG_URL=http://localhost:8077/ask
# ДОЛЖЕН быть >= LLM_TIMEOUT в rag/ragsvc/config.py (240 с). 120 обрывал медленный
# ответ АФМ раньше времени → 502 вместо реального ответа.
RAG_TIMEOUT=260
# LLM / эмбеддинги / индекс / top_k самого RAG — в rag/.env, НЕ здесь.

# ===== Загрузка аудио =====
MAX_UPLOAD_MB=25


