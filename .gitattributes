# Windows-скрипты — ТОЛЬКО CRLF. cmd.exe спотыкается на метках, goto и блоках
# if(...) в файлах с LF, а правим мы их с macOS/Linux (git иначе оставит LF).
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Всё остальное текстовое — LF (shell-скрипты с CRLF не запускаются на Linux:
# "bad interpreter: /usr/bin/env bash^M").
*.sh  text eol=lf
*.py  text eol=lf
*.md  text eol=lf
*.service text eol=lf
