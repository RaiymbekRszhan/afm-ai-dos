# Python
__pycache__/
*.pyc
.pytest_cache/

# macOS
.DS_Store

# venv (каждый сервис — свой; не переносятся Mac<->Linux)
.venv/
.venv-f5/
.venv-spark/
.venv-omni/

# секреты/локальная конфигурация
.env
# копии .env — тоже секреты. На сервере АФМ рядом с проектом лежит
# .env.bak.2026-07-29, и без этой строки он попадёт под `git add -A`.
.env.*
!.env.example
# Пропуска киосков (kiosks-keys.txt) — секреты того же класса, что .env: с ними
# любая машина притворится любым регионом. Живут на сервере и на машине сборки.
kiosks-keys.txt

# словарь tiktoken, ПЕРЕСОЗДАННЫЙ НА СЕРВЕРЕ (путь в /etc/default/ai-dos):
# версия из rag/vendor/ там не подошла, рабочая копия машинно-зависима.
/vendor/

# список отключённых точек — ОПЕРАТИВНОЕ состояние сервера, не код. В git ему
# нельзя ещё и потому, что обновление (git reset --hard) молча включило бы
# обратно регионы, которые сейчас на ремонте.
/kiosks-disabled.txt

# метка «всем точкам перечитать страницу» (кнопка в админке). Тоже оперативное
# состояние: в git она означала бы, что каждое обновление кода перезагружает
# флот заново — время изменения файла менялось бы при каждой выкатке.
/kiosks-reload.txt

# аудио (генерируемое/временное) — но образцы для клона голоса НУЖНЫ
*.wav
*.aiff
*.mp3
*.m4a
!refs/*.wav
!refs/*.m4a
refs/*.omni.pt

# тяжёлые/скачиваемые/генерируемые артефакты
# (модели TTS качаются на месте; код Spark-TTS клонируется; индекс RAG строится через ingest)
models/
spark_tts_repo/
rag/rag_storage/
rag/rag_storage.bak.*/
# промежуточные txt конвертера (исходник — data/raw/*.docx)
rag/_convert/*.txt

app/static/aidos_editor.py

# отладочный блокнот логов (эндпоинт /debug/log)
debug/

# прогоны бенча TTS (WAV + отчёты) — артефакты замеров, в git не нужны
out/

# ролик для конкурса: бинарник ffmpeg и промежуточные кадры/wav — не в git
VIDEO/tools/
VIDEO/build/

# логи взаимодействий (ПДн граждан!) — только на сервере, в git НЕ попадают
logs/
*.jsonl

# инструкции для Claude Code — в репозиторий не публикуем
CLAUDE.md
