[Unit]
Description=Ai-dos оркестратор (STT -> RAG -> TTS, порт 8000)
# rag — обязателен (источник ответа). f5/spark нужны ТОЛЬКО для локальной
# TTS-топологии (B в ai-dos.env); при GPU-F5 + ElevenLabs их не поднимают,
# поэтому здесь они лишь в After (порядок, если запущены), не в Wants.
After=network-online.target ai-dos-rag.service ai-dos-f5.service ai-dos-spark.service
Wants=network-online.target ai-dos-rag.service

[Service]
Type=simple
User=ai-dos
WorkingDirectory=/opt/ai-dos
# ЕДИНЫЙ источник топологии TTS/STT/RAG — тот же файл, что сорсит run_api.sh (N2).
# Скопируй deploy/ai-dos.env.example -> /opt/ai-dos/ai-dos.env и подгони.
# `-` — файл необязателен: без него берутся дефолты app/config.py.
EnvironmentFile=-/opt/ai-dos/ai-dos.env
# Секреты (ELEVENLABS_API_KEY и пр.) — в /opt/ai-dos/.env (читает pydantic).
# host 0.0.0.0: к оркестратору напрямую ходят браузеры граждан. За TLS-прокси
# (рекомендуется) можно сузить до 127.0.0.1.
ExecStart=/opt/ai-dos/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

# Базовый sandbox (сервис принимает недоверенный ввод граждан, работает 24/7).
# ProtectHome/ProtectSystem=strict НЕ ставим: модели/HF-кэш могут быть в домашнем
# каталоге пользователя ai-dos — иначе загрузка Whisper сломается.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectControlGroups=true
ProtectKernelTunables=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
