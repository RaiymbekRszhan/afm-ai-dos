[Unit]
Description=Ai-dos оркестратор (STT -> RAG -> TTS, порт 8000)
# rag (источник ответа) — единственная локальная зависимость. TTS/STT (F5, Spark,
# STT, ElevenLabs) живут на сервере АФМ / в облаке — не systemd-юниты этой машины.
After=network-online.target ai-dos-rag.service
Wants=network-online.target ai-dos-rag.service

[Service]
Type=simple
User=ai-dos
WorkingDirectory=/opt/ai-dos
# Топология TTS/STT/RAG — в /opt/ai-dos/.env (его читает app/config.py через pydantic,
# т.к. WorkingDirectory=/opt/ai-dos). ЕДИНЫЙ источник: тот же .env действует и при
# запуске без systemd (run_api.sh может переопределить для отладки). Раньше здесь
# были Environment=F5_URL=localhost… — они ПЕРЕБИВАЛИ .env мёртвыми локальными
# адресами (env-переменные приоритетнее .env-файла); убраны (N2).
# API_HOST нужен для подстановки в ExecStart (systemd не читает pydantic-.env, только
# своё окружение). Дефолт 127.0.0.1: снаружи к оркестратору ходит только video_ui
# (:8100) с этой же машины (N6). Открыть за TLS-прокси: API_HOST=0.0.0.0.
Environment=API_HOST=127.0.0.1
# Секреты (ELEVENLABS_API_KEY и пр.) — тоже в /opt/ai-dos/.env (читает pydantic).
ExecStart=/opt/ai-dos/.venv/bin/uvicorn app.main:app --host ${API_HOST} --port 8000
Restart=always
RestartSec=5

# Базовый sandbox (сервис принимает недоверенный ввод граждан, работает 24/7).
# ProtectHome/ProtectSystem=strict НЕ ставим: модели/HF-кэш могут быть в домашнем
# каталоге пользователя ai-dos — иначе загрузка Whisper сломается.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectControlGroups=true
ProtectKernelTunables=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
