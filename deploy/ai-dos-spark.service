[Unit]
Description=Ai-dos Spark (казахский TTS, порт 8809)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ai-dos
WorkingDirectory=/opt/ai-dos
# GPU: cuda. На CPU убрать строку (run.sh по умолчанию cpu).
Environment=SPARK_DEVICE=cuda
Environment=HF_HUB_OFFLINE=1
Environment=TRANSFORMERS_OFFLINE=1
ExecStart=/bin/bash spark_server/run.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
