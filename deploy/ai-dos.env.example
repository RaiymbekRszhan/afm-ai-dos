# ═══════════════════════════════════════════════════════════════════════════
#  Ai-dos — ЕДИНЫЙ источник истины окружения (топология TTS/STT/RAG).  N2.
#
#  Один файл читают ОБА пути запуска, поэтому «деплой по инструкции» = то, что
#  проверяли:
#    • systemd  — ai-dos-api.service подключает его через EnvironmentFile;
#    • run_api.sh — сорсит его в начале (deploy/ai-dos.env), если файл есть.
#  Переменные отсюда попадают в окружение процесса, и app/config.py (pydantic)
#  их читает (env-переменные приоритетнее .env-файла).
#
#  УСТАНОВКА: скопируй в корень проекта как  ai-dos.env  и подгони под свой сервер.
#    cp deploy/ai-dos.env.example ai-dos.env   # (в git не коммитим: топология сервера)
#
#  СЕКРЕТЫ (ELEVENLABS_API_KEY и пр.) держи в .env — НЕ здесь: этот файл про
#  топологию, .env про ключи (оба читает app/config.py).
# ═══════════════════════════════════════════════════════════════════════════

# Офлайн-режим HuggingFace (сеть АФМ без интернета).
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# Источник ответа — RAG-сервис (на той же машине).
RAG_URL=http://localhost:8077/ask

# ─── Сетевая поверхность оркестратора (N6) ──────────────────────────────────
# По умолчанию :8000 слушает 127.0.0.1: снаружи к нему ходит только video_ui
# (:8100) с этой же машины. Открыть на всю сеть (за TLS-прокси): API_HOST=0.0.0.0.
API_HOST=127.0.0.1
# Swagger /docs и /openapi.json в проде выключены. Включить для отладки: ENABLE_DOCS=1.
ENABLE_DOCS=0

# ─── STT ────────────────────────────────────────────────────────────────────
# По умолчанию оба языка — STT-сервер АФМ (он тянет и казахский).
STT_URL=http://192.168.165.2:8804/transcribe
STT_KK_USE_WHISPER=false
# Локальный Whisper-kk (точнее на шумном микрофоне, но грузит torch+веса на ЭТУ
# машину): STT_KK_USE_WHISPER=true  (+ WHISPER_DEVICE=cuda).

# ═══ ТОПОЛОГИЯ TTS — выбери ОДНУ ════════════════════════════════════════════

# ── (A) ПИЛОТНЫЙ ДЕФОЛТ: русский F5 на GPU-ноде АФМ + казахский ElevenLabs ────
# Русский — multipart-F5 на GPU-сервере АФМ (клиентский референс в каждом запросе).
TTS_PROVIDER=f5
F5_URL=http://192.168.165.2:8991/tts
F5_REF_AUDIO=refs/ref_ru_f5_padded.wav
F5_REF_TEXT=@refs/ref_ru.txt
# Казахский — ElevenLabs (eleven_v3, звучит чисто). ⚠️ НУЖЕН ИНТЕРНЕТ +
# ELEVENLABS_API_KEY / ELEVENLABS_VOICE_ID в .env.
TTS_KK_PROVIDER=eleven

# ── (B) АЛЬТЕРНАТИВА: полностью локальный TTS (офлайн, без интернета) ─────────
# Раскомментируй блок ниже и закомментируй (A). Требует поднятых локальных
# сервисов: ai-dos-f5.service + ai-dos-spark.service (см. deploy/README.md).
# TTS_PROVIDER=f5
# F5_URL=http://localhost:8810/tts
# F5_REF_AUDIO=
# F5_REF_TEXT=
# TTS_KK_PROVIDER=spark
# SPARK_URL=http://localhost:8809/tts
