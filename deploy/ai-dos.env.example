# Машинно-зависимые ключи запуска Ai-dos. Копируется в /etc/default/ai-dos и
# читается ВСЕМИ юнитами (EnvironmentFile=-/etc/default/ai-dos).
#
#   sudo cp deploy/ai-dos.env.example /etc/default/ai-dos
#   sudo nano /etc/default/ai-dos          # подогнать под машину
#   sudo systemctl restart ai-dos-rag ai-dos-api ai-dos-video-ui
#
# ЗАЧЕМ ОТДЕЛЬНЫЙ ФАЙЛ. Раньше это правили прямо в run_api.sh / video_ui/run.sh
# на сервере — и каждое обновление кода стирало правки: киоск-страница уезжала
# с :80 на :8100 (все точки видели «недоступно»), а RAG лез за словарём в
# интернет и не стартовал. Здесь правки переживают обновления.
#
# ⚠️ ЧТО СЮДА КЛАСТЬ НЕЛЬЗЯ: топологию TTS/STT (TTS_PROVIDER, F5_URL, SPARK_URL,
# TTS_KK_PROVIDER и т.п.) и секреты. Их место — .env в корне проекта, который
# читает pydantic. Переменные окружения ПРИОРИТЕТНЕЕ .env и молча его перебьют —
# ровно этот баг чинила находка N2 аудита.

# Порт киоск-страницы (video_ui). 8100 — умолчание репозитория; на сервере АФМ
# страница отдаётся сразу на :80, туда ходят киоски.
VIDEO_UI_PORT=80

# Каталог с завендоренным словарём tiktoken для RAG. Умолчание —
# <проект>/rag/vendor/tiktoken; на сервере АФМ рабочий кэш пришлось пересоздать
# в другом месте (версия из репозитория не подошла). Без верного пути RAG идёт
# за словарём в интернет и падает на TLS-прокси, то есть НЕ СТАРТУЕТ.
#TIKTOKEN_CACHE_DIR=/root/afm-ai-dos/vendor/tiktoken

# Корневой сертификат TLS-прокси АФМ, если он у вас есть: httpx его уважает, и
# тогда ElevenLabs работает с ПОЛНОЙ проверкой сертификата (в .env при этом
# ELEVENLABS_VERIFY_SSL можно вернуть в true). В .env класть бесполезно:
# pydantic читает .env в свои поля и в окружение процесса ничего не экспортирует.
#SSL_CERT_FILE=/opt/ai-dos/ca-bundle.pem

# Исходящий прокси, если в контуре он обязателен.
#HTTPS_PROXY=http://proxy.afm.local:3128
