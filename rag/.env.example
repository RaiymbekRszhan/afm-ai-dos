# ── RAG-сервис АФМ (порт 8077) ──────────────────────────────────────────────
# ОТДЕЛЬНЫЙ venv от голосового слоя (lightrag/torch конфликтуют). См. rag/README.md.
# Читается rag/ragsvc/config.py. Режим поиска — naive (только вектора), задан в КОДЕ.

# Embedding (сервер эмбеддингов АФМ)
EMBEDDING_BASE_URL=http://192.168.165.2:8806/v1
EMBEDDING_MODEL=qwen3-embedding-8b
EMBEDDING_API_KEY=dummy
# ВАЖНО: реальную размерность узнай через `python -m scripts.check` и впиши сюда.
# Если разойдётся с базой — поиск работать не будет.
EMBEDDING_DIM=4096
EMBEDDING_MAX_TOKENS=8192

# LLM — генеративная модель АФМ (ОБЯЗАТЕЛЬНО, иначе сервис не стартует)
LLM_BASE_URL=http://192.168.165.2:8901/v1
LLM_MODEL=qwen3-next-80b-instruct
LLM_API_KEY=EMPTY

# Reranker (по желанию; заметно поднимает точность на юр.текстах)
RERANK_ENABLED=0
RERANK_BASE_URL=
RERANK_MODEL=bge-reranker-v2-m3
RERANK_API_KEY=dummy

# Поиск / чанкинг
WORKING_DIR=./rag_storage      # папка индекса (строит `python -m ragsvc.ingest`)
CHUNK_TOKEN_SIZE=1200
CHUNK_OVERLAP=100
TOP_K=40                       # кандидатов из векторного поиска
CHUNK_TOP_K=12                 # чанков в LLM-контекст

# Server
HOST=0.0.0.0
PORT=8077
